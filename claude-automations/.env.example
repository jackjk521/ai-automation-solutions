ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 21-social-trend-newsletter only
# Enable Custom Search JSON API in Google Cloud Console, then create a
# Programmable Search Engine at https://programmablesearchengine.google.com
# (turn ON "Search the entire web" for site: operator to work)
GOOGLE_CSE_API_KEY=your_google_cse_api_key
GOOGLE_CSE_ID=your_programmable_search_engine_id

# Gmail SMTP — enable App Password: Google Account → Security → App Passwords
EMAIL_FROM=you@gmail.com
EMAIL_APP_PASSWORD=your_16_char_app_password
EMAIL_TO=you@gmail.com
