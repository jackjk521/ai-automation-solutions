{
  "name": "Lead Capture to CRM",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lead-capture",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "values": {
          "string": [
            { "name": "firstName", "value": "={{ $json.body.first_name || $json.body.firstName || '' }}" },
            { "name": "lastName", "value": "={{ $json.body.last_name || $json.body.lastName || '' }}" },
            { "name": "email", "value": "={{ ($json.body.email || '').toLowerCase().trim() }}" },
            { "name": "company", "value": "={{ $json.body.company || $json.body.organization || '' }}" },
            { "name": "phone", "value": "={{ $json.body.phone || $json.body.phone_number || '' }}" },
            { "name": "source", "value": "={{ $json.body.source || 'website-form' }}" },
            { "name": "capturedAt", "value": "={{ $now.toISO() }}" }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0002-4000-8000-000000000002",
      "name": "Normalize Fields",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            { "value1": "={{ $json.email }}", "operation": "isNotEmpty" },
            { "value1": "={{ $json.firstName }}", "operation": "isNotEmpty" }
          ]
        },
        "combineOperation": "all"
      },
      "id": "a1b2c3d4-0003-4000-8000-000000000003",
      "name": "Required Fields Present?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [650, 300]
    },
    {
      "parameters": {
        "operation": "search",
        "application": "={{ $vars.AIRTABLE_BASE_ID }}",
        "table": "Leads",
        "filterByFormula": "={Email}=\"{{ $json.email }}\"",
        "options": {}
      },
      "id": "a1b2c3d4-0004-4000-8000-000000000004",
      "name": "Search Existing Lead",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 1,
      "position": [850, 200],
      "credentials": { "airtableApi": { "id": "airtable-cred-01", "name": "Airtable Account" } }
    },
    {
      "parameters": {
        "conditions": {
          "number": [{ "value1": "={{ $items().length }}", "operation": "larger", "value2": 0 }]
        }
      },
      "id": "a1b2c3d4-0005-4000-8000-000000000005",
      "name": "Is Duplicate?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1050, 200]
    },
    {
      "parameters": {
        "operation": "create",
        "application": "={{ $vars.AIRTABLE_BASE_ID }}",
        "table": "Leads",
        "additionalFields": {
          "fields": [
            { "fieldId": "First Name", "fieldValue": "={{ $('Normalize Fields').item.json.firstName }}" },
            { "fieldId": "Last Name", "fieldValue": "={{ $('Normalize Fields').item.json.lastName }}" },
            { "fieldId": "Email", "fieldValue": "={{ $('Normalize Fields').item.json.email }}" },
            { "fieldId": "Company", "fieldValue": "={{ $('Normalize Fields').item.json.company }}" },
            { "fieldId": "Status", "fieldValue": "New" },
            { "fieldId": "Created At", "fieldValue": "={{ $('Normalize Fields').item.json.capturedAt }}" }
          ]
        }
      },
      "id": "a1b2c3d4-0006-4000-8000-000000000006",
      "name": "Create Lead in Airtable",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 1,
      "position": [1250, 100],
      "credentials": { "airtableApi": { "id": "airtable-cred-01", "name": "Airtable Account" } }
    },
    {
      "parameters": {
        "fromEmail": "sales@yourcompany.com",
        "toEmail": "={{ $('Normalize Fields').item.json.email }}",
        "subject": "Welcome! Thanks for your interest in [Your Company]",
        "emailType": "html",
        "message": "<h2>Hi {{ $('Normalize Fields').item.json.firstName }},</h2><p>Thank you for reaching out! A member of our team will be in touch within 1 business day.</p><p>Best,<br><strong>The Sales Team</strong></p>",
        "options": {}
      },
      "id": "a1b2c3d4-0007-4000-8000-000000000007",
      "name": "Send Welcome Email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2,
      "position": [1450, 50],
      "credentials": { "gmailOAuth2": { "id": "gmail-cred-01", "name": "Gmail Account" } }
    },
    {
      "parameters": {
        "channel": "#sales-leads",
        "text": ":tada: *New Lead!*\n*Name:* {{ $('Normalize Fields').item.json.firstName }} {{ $('Normalize Fields').item.json.lastName }}\n*Email:* {{ $('Normalize Fields').item.json.email }}\n*Company:* {{ $('Normalize Fields').item.json.company }}",
        "otherOptions": {}
      },
      "id": "a1b2c3d4-0008-4000-8000-000000000008",
      "name": "Notify Sales on Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2,
      "position": [1650, 100],
      "credentials": { "slackApi": { "id": "slack-cred-01", "name": "Slack Account" } }
    },
    {
      "parameters": {
        "operation": "update",
        "application": "={{ $vars.AIRTABLE_BASE_ID }}",
        "table": "Leads",
        "id": "={{ $('Search Existing Lead').item.json.id }}",
        "updateFields": {
          "fields": [
            { "fieldId": "Last Seen", "fieldValue": "={{ $now.toISO() }}" },
            { "fieldId": "Latest Source", "fieldValue": "={{ $('Normalize Fields').item.json.source }}" }
          ]
        }
      },
      "id": "a1b2c3d4-0009-4000-8000-000000000009",
      "name": "Update Duplicate Lead",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 1,
      "position": [1250, 300],
      "credentials": { "airtableApi": { "id": "airtable-cred-01", "name": "Airtable Account" } }
    },
    {
      "parameters": {
        "values": {
          "string": [
            { "name": "logMessage", "value": "Duplicate lead: {{ $('Normalize Fields').item.json.email }} at {{ $now.toISO() }}" },
            { "name": "action", "value": "duplicate_updated" }
          ]
        }
      },
      "id": "a1b2c3d4-0010-4000-8000-000000000010",
      "name": "Log Duplicate Activity",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [1450, 300]
    },
    {
      "parameters": {},
      "id": "a1b2c3d4-0011-4000-8000-000000000011",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [250, 550]
    },
    {
      "parameters": {
        "channel": "#ops-alerts",
        "text": ":red_circle: *Lead Capture Error*\n*Workflow:* {{ $workflow.name }}\n*Error:* {{ $json.execution.error.message }}",
        "otherOptions": {}
      },
      "id": "a1b2c3d4-0012-4000-8000-000000000012",
      "name": "Alert on Error",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2,
      "position": [450, 550],
      "credentials": { "slackApi": { "id": "slack-cred-01", "name": "Slack Account" } }
    }
  ],
  "connections": {
    "Webhook": { "main": [[{ "node": "Normalize Fields", "type": "main", "index": 0 }]] },
    "Normalize Fields": { "main": [[{ "node": "Required Fields Present?", "type": "main", "index": 0 }]] },
    "Required Fields Present?": { "main": [[{ "node": "Search Existing Lead", "type": "main", "index": 0 }], []] },
    "Search Existing Lead": { "main": [[{ "node": "Is Duplicate?", "type": "main", "index": 0 }]] },
    "Is Duplicate?": { "main": [[{ "node": "Update Duplicate Lead", "type": "main", "index": 0 }], [{ "node": "Create Lead in Airtable", "type": "main", "index": 0 }]] },
    "Create Lead in Airtable": { "main": [[{ "node": "Send Welcome Email", "type": "main", "index": 0 }]] },
    "Send Welcome Email": { "main": [[{ "node": "Notify Sales on Slack", "type": "main", "index": 0 }]] },
    "Update Duplicate Lead": { "main": [[{ "node": "Log Duplicate Activity", "type": "main", "index": 0 }]] },
    "Error Trigger": { "main": [[{ "node": "Alert on Error", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "meta": { "templateCredsSetupCompleted": false, "instanceId": "template" }
}
