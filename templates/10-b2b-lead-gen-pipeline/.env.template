# ── LLM CONFIG ─────────────────────────────────────────────────────────
# Swap provider by changing these 4 lines. Nothing else in the workflow changes.
#
# Provider options and their endpoints:
#   deepseek  → https://api.deepseek.com/v1/chat/completions      (RECOMMENDED — cheapest)
#   qwen      → https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
#   openai    → https://api.openai.com/v1/chat/completions
#   moonshot  → https://api.moonshot.cn/v1/chat/completions
#   anthropic → https://api.anthropic.com/v1/messages              (handled separately in router)
#
# Model recommendations by provider:
#   deepseek  → deepseek-chat      ($0.14 input / $0.28 output per 1M tokens)
#   qwen      → qwen-max           ($0.40 input / $1.20 output per 1M tokens)
#   openai    → gpt-4o-mini        ($0.15 input / $0.60 output per 1M tokens)
#   moonshot  → moonshot-v1-8k     ($0.20 input / $0.60 output per 1M tokens)
#   anthropic → claude-sonnet-4-6  ($3.00 input / $15.00 output per 1M tokens)

LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com/v1/chat/completions
LLM_MODEL=deepseek-chat
LLM_API_KEY=

# ── SCRAPING & ENRICHMENT ───────────────────────────────────────────────
# One Apify token covers: Google Maps scraper + BuiltWith actor + SERP actor
# Sign up free at https://apify.com — $5 free credit on signup
APIFY_TOKEN=

# Optional: direct BuiltWith API key (only needed at >500 domains/month)
# Start with Apify actor — same data, covered by your Apify credits
# Direct API at https://api.builtwith.com — $295/mo, skip unless high volume
BUILTWITH_API_KEY=

# Google PageSpeed Insights API — completely free, unlimited
# Enable at: https://console.cloud.google.com → APIs → PageSpeed Insights API
PAGESPEED_API_KEY=

# Open PageRank API — completely free, unlimited
# Sign up at: https://www.domcop.com/openpagerank/documentation
OPEN_PAGERANK_KEY=

# ── STORAGE ─────────────────────────────────────────────────────────────
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_CREDENTIAL=

# ── OUTPUT ──────────────────────────────────────────────────────────────
ALERT_EMAIL=

# Vercel token for MVP HTML hosting (free hobby tier)
# Create at: https://vercel.com/account/tokens — needs deployments:write scope
VERCEL_TOKEN=

# ── SAFETY LIMITS — tune to protect your server ─────────────────────────
MAX_LEADS_FETCHED=30          # Apify fetches this many results per niche/location
TOP_LEADS_KEPT=10             # After scoring all 30, only top N written to Sheets
MAX_APIFY_POLL_ATTEMPTS=15    # Poll timeout: 15 × 10s = 150s max per actor run
MAX_ERRORS_BEFORE_ABORT=5     # Abort run if this many enrichment errors occur
SCORE_THRESHOLD=70            # Minimum total score to trigger MVP generation
