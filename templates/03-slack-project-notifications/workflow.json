{
  "name": "Slack Project Notifications",
  "nodes": [
    {
      "id": "9a5bf8d8-99d5-4d2a-91b5-ad0892f91adf",
      "name": "\ud83d\udccc Slack Project Notifications",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -480,
        -160
      ],
      "parameters": {
        "content": "## Slack Project Notifications\n\nReceives GitHub / Jira / Trello webhooks, identifies event type, formats a clean Slack message, posts to the correct channel, and logs every event to Google Sheets.\n\n**Credentials needed:**\n- Slack API (chat:write)\n- Google Sheets OAuth2",
        "height": 240,
        "width": 360,
        "color": 5
      }
    },
    {
      "id": "3d20a565-9462-4393-8308-58651fc867d8",
      "name": "Webhook \u2013 Receive Event",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "slack-project-notif",
        "responseMode": "onReceived",
        "responseData": "allEntries"
      }
    },
    {
      "id": "8c7f32c9-690b-4024-a502-c7d5f28f68d9",
      "name": "Detect Event Source & Type",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "jsCode": "\nconst body = $input.first().json.body ?? $input.first().json;\nlet source = 'unknown';\nlet eventType = 'unknown';\nlet title = '';\nlet actor = '';\nlet url = '';\nlet repo = '';\n\n// GitHub detection\nif (body.repository && body.sender) {\n  source = 'github';\n  actor = body.sender.login;\n  repo = body.repository.full_name;\n  if (body.pull_request) {\n    eventType = body.action === 'opened' ? 'PR Opened' : body.action === 'closed' && body.pull_request.merged ? 'PR Merged' : 'PR ' + body.action;\n    title = body.pull_request.title;\n    url = body.pull_request.html_url;\n  } else if (body.issue) {\n    eventType = 'Issue ' + body.action;\n    title = body.issue.title;\n    url = body.issue.html_url;\n  } else if (body.commits) {\n    eventType = 'Push';\n    title = `${body.commits.length} commit(s) to ${body.ref}`;\n    url = body.compare;\n  }\n}\n// Jira detection\nelse if (body.issue && body.issue.fields) {\n  source = 'jira';\n  eventType = body.webhookEvent?.replace('jira:','') ?? 'issue_event';\n  actor = body.user?.displayName ?? 'Jira User';\n  title = body.issue.fields.summary;\n  url = `https://your-jira.atlassian.net/browse/${body.issue.key}`;\n  repo = body.issue.fields.project?.name ?? '';\n}\n// Trello detection\nelse if (body.action && body.action.type) {\n  source = 'trello';\n  eventType = body.action.type;\n  actor = body.action.memberCreator?.fullName ?? 'Trello User';\n  title = body.action.data?.card?.name ?? body.action.data?.board?.name ?? '';\n  url = `https://trello.com/c/${body.action.data?.card?.shortLink ?? ''}`;\n  repo = body.action.data?.board?.name ?? '';\n}\n\nreturn [{json: {source, eventType, title, actor, url, repo, timestamp: new Date().toISOString()}}];\n"
      }
    },
