{
  "name": "AI Email Triage",
  "nodes": [
    {
      "parameters": { "pollTimes": { "item": [{"mode": "everyMinute"}] }, "filters": { "readStatus": "unread" }, "options": {} },
      "id": "et-0001-4001-8001-000000000401",
      "name": "Gmail Trigger",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1,
      "position": [250, 300],
      "credentials": { "gmailOAuth2": { "id": "gmail-cred-01", "name": "Gmail Account" } }
    },
    {
      "parameters": {
        "assignments": { "assignments": [
          { "id": "f001", "name": "subject", "value": "={{ $json.subject || '(no subject)' }}", "type": "string" },
          { "id": "f002", "name": "sender", "value": "={{ $json.from }}", "type": "string" },
          { "id": "f003", "name": "body", "value": "={{ ($json.text || $json.snippet || '').slice(0, 2000) }}", "type": "string" },
          { "id": "f004", "name": "messageId", "value": "={{ $json.id }}", "type": "string" }
        ]},
        "options": {}
      },
      "id": "et-0002-4002-8002-000000000402",
      "name": "Extract Email Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [450, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": { "parameters": [
          { "name": "anthropic-version", "value": "2023-06-01" },
          { "name": "content-type", "value": "application/json" }
        ]},
        "sendBody": true,
        "bodyParameters": { "parameters": [
          { "name": "model", "value": "claude-haiku-4-5-20251001" },
          { "name": "max_tokens", "value": "256" },
          { "name": "messages", "value": "=[{\"role\":\"user\",\"content\":\"Classify this email into exactly one category: Urgent, Follow-up, Information, or Spam.\\nRespond with JSON only: {\\\"category\\\": \\\"...\\\", \\\"reason\\\": \\\"one sentence\\\"}\\nFrom: {{ $json.sender }}\\nSubject: {{ $json.subject }}\\nBody: {{ $json.body }}\"}]" }
        ]},
        "options": {}
      },
      "id": "et-0003-4003-8003-000000000403",
      "name": "Classify Email (AI)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [650, 300],
      "credentials": { "httpHeaderAuth": { "id": "anthropic-cred-01", "name": "Anthropic API" } }
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.item.json;\nlet text = '';\ntry { text = raw.content[0].text; } catch(e) { text = '{\"category\":\"Information\"}'; }\nlet parsed;\ntry { const m = text.match(/\\{[^}]+\\}/); parsed = m ? JSON.parse(m[0]) : {category:'Information'}; } catch(e) { parsed = {category:'Information'}; }\nif (!['Urgent','Follow-up','Information','Spam'].includes(parsed.category)) parsed.category = 'Information';\nreturn { category: parsed.category, reason: parsed.reason || '' };"
      },
      "id": "et-0004-4004-8004-000000000404",
      "name": "Parse AI Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [850, 300]
    },
    {
      "parameters": {
        "rules": { "rules": [
          { "outputKey": "urgent", "conditions": { "conditions": [{ "leftValue": "={{ $json.category }}", "rightValue": "Urgent", "operator": { "type": "string", "operation": "equals" } }], "combinator": "and" } },
          { "outputKey": "followup", "conditions": { "conditions": [{ "leftValue": "={{ $json.category }}", "rightValue": "Follow-up", "operator": { "type": "string", "operation": "equals" } }], "combinator": "and" } },
          { "outputKey": "information", "conditions": { "conditions": [{ "leftValue": "={{ $json.category }}", "rightValue": "Information", "operator": { "type": "string", "operation": "equals" } }], "combinator": "and" } },
          { "outputKey": "spam", "conditions": { "conditions": [{ "leftValue": "={{ $json.category }}", "rightValue": "Spam", "operator": { "type": "string", "operation": "equals" } }], "combinator": "and" } }
        ]},
        "options": {}
      },
      "id": "et-0005-4005-8005-000000000405",
      "name": "Route by Category",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [1050, 300]
    },
    {
      "parameters": { "operation": "addLabels", "messageId": "={{ $('Extract Email Data').item.json.messageId }}", "labelIds": ["Label_URGENT"] },
      "id": "et-0006-4006-8006-000000000406",
      "name": "Label: Urgent",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2,
      "position": [1300, 100],
      "credentials": { "gmailOAuth2": { "id": "gmail-cred-01", "name": "Gmail Account" } }
    },
    {
      "parameters": { "resource": "databasePage", "operation": "create", "databaseId": "YOUR_NOTION_DATABASE_ID", "title": "URGENT: {{ $('Extract Email Data').item.json.subject }}" },
      "id": "et-0007-4007-8007-000000000407",
      "name": "Create Notion Task",
      "type": "n8n-nodes-base.notion",
      "typeVersion": 2,
      "position": [1500, 50],
      "credentials": { "notionApi": { "id": "notion-cred-01", "name": "Notion Account" } }
    },
    {
      "parameters": { "channel": "#urgent-emails", "text": ":rotating_light: *URGENT EMAIL*\n*From:* {{ $('Extract Email Data').item.json.sender }}\n*Subject:* {{ $('Extract Email Data').item.json.subject }}", "otherOptions": {} },
      "id": "et-0008-4008-8008-000000000408",
      "name": "Slack: Urgent Alert",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2,
      "position": [1700, 100],
      "credentials": { "slackApi": { "id": "slack-cred-01", "name": "Slack Account" } }
    },
    {
      "parameters": { "operation": "addLabels", "messageId": "={{ $('Extract Email Data').item.json.messageId }}", "labelIds": ["Label_FOLLOW_UP"] },
      "id": "et-0009-4009-8009-000000000409",
      "name": "Label: Follow-up",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2,
      "position": [1300, 250],
      "credentials": { "gmailOAuth2": { "id": "gmail-cred-01", "name": "Gmail Account" } }
    },
    {
      "parameters": { "operation": "addLabels", "messageId": "={{ $('Extract Email Data').item.json.messageId }}", "labelIds": ["Label_INFORMATION"] },
      "id": "et-0010-4010-8010-000000000410",
      "name": "Label: Information",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2,
      "position": [1300, 400],
      "credentials": { "gmailOAuth2": { "id": "gmail-cred-01", "name": "Gmail Account" } }
    },
    {
      "parameters": { "operation": "addLabels", "messageId": "={{ $('Extract Email Data').item.json.messageId }}", "labelIds": ["Label_SPAM"] },
      "id": "et-0011-4011-8011-000000000411",
      "name": "Label: Spam",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2,
      "position": [1300, 550],
      "credentials": { "gmailOAuth2": { "id": "gmail-cred-01", "name": "Gmail Account" } }
    }
  ],
  "connections": {
    "Gmail Trigger": { "main": [[{ "node": "Extract Email Data", "type": "main", "index": 0 }]] },
    "Extract Email Data": { "main": [[{ "node": "Classify Email (AI)", "type": "main", "index": 0 }]] },
    "Classify Email (AI)": { "main": [[{ "node": "Parse AI Response", "type": "main", "index": 0 }]] },
    "Parse AI Response": { "main": [[{ "node": "Route by Category", "type": "main", "index": 0 }]] },
    "Route by Category": { "main": [[{ "node": "Label: Urgent", "type": "main", "index": 0 }], [{ "node": "Label: Follow-up", "type": "main", "index": 0 }], [{ "node": "Label: Information", "type": "main", "index": 0 }], [{ "node": "Label: Spam", "type": "main", "index": 0 }]] },
    "Label: Urgent": { "main": [[{ "node": "Create Notion Task", "type": "main", "index": 0 }]] },
    "Create Notion Task": { "main": [[{ "node": "Slack: Urgent Alert", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "meta": { "templateCredsSetupCompleted": false, "instanceId": "template" }
}
