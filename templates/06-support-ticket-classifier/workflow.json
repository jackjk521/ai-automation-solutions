        "resource": "message",
        "channel": "#bug-reports",
        "text": "={{ ':beetle: *[' + $json.priority + ']* ' + $json.subject + '\\n*Customer:* ' + $json.customer_name + ' (' + $json.plan + ' plan)\\n*Sentiment:* ' + $json.sentiment + '\\n' + $json.ai_summary }}"
      }
    },
    {
      "id": "405a36e6-7253-4567-8525-7a7eeaa4febc",
      "name": "Slack \u2013 #general-support",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [
        960,
        400
      ],
      "parameters": {
        "operation": "post",
        "resource": "message",
        "channel": "#general-support",
        "text": "={{ ':speech_balloon: *[' + $json.priority + ']* ' + $json.subject + '\\n*Category:* ' + $json.category + '\\n*Customer:* ' + $json.customer_name }}"
      }
    },
    {
      "id": "bf2aa119-29dc-4c01-94b8-f478c1ebb929",
      "name": "Gmail \u2013 Auto Acknowledgement",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1200,
        80
      ],
      "parameters": {
        "operation": "send",
        "resource": "message",
        "sendTo": "={{ $json.customer_email }}",
        "subject": "={{ 'Re: ' + $json.subject + ' [' + $json.ticket_id + ']' }}",
        "message": "={{ '<div style=\"font-family:Arial,sans-serif;max-width:600px\"><p>Hi ' + $json.customer_name + ',</p><p>Thank you for reaching out. We have received your support request and our team will be in touch shortly.</p><table style=\"border-collapse:collapse;width:100%\"><tr><td style=\"padding:8px;border:1px solid #ddd\"><b>Ticket ID</b></td><td style=\"padding:8px;border:1px solid #ddd\">' + $json.ticket_id + '</td></tr><tr><td style=\"padding:8px;border:1px solid #ddd\"><b>Category</b></td><td style=\"padding:8px;border:1px solid #ddd\">' + $json.category + '</td></tr><tr><td style=\"padding:8px;border:1px solid #ddd\"><b>Priority</b></td><td style=\"padding:8px;border:1px solid #ddd\">' + $json.priority + '</td></tr></table><p>Expected response times:<br>High priority: 2 hours<br>Medium priority: 8 hours<br>Low priority: 24 hours</p><p>Best regards,<br>Support Team</p></div>' }}",
        "emailType": "html"
      }
    }
  ],
