          "value": {
            "Date Added": "={{ $json.date_added }}",
            "Week": "={{ $json.week }}",
            "Business Name": "={{ $json.business_name }}",
            "Website URL": "={{ $json.website_url }}",
            "Niche": "={{ $json.niche }}",
            "Location": "={{ $json.location }}",
            "Has Website": "={{ $json.has_website }}",
            "Tech Stack": "={{ $json.tech_stack }}",
            "Site Score": "={{ $json.site_score }}",
            "Priority": "={{ $json.priority }}",
            "Has SSL": "={{ $json.has_ssl }}",
            "Phone": "={{ $json.phone }}",
            "Address": "={{ $json.address }}",
            "Email Subject": "={{ $json.email_subject }}",
            "Email Body": "={{ $json.email_body }}",
            "Outreach Status": "={{ $json.outreach_status }}",
            "Follow-up Date": "={{ $json.follow_up_date }}",
            "Contract Value": "={{ $json.contract_value }}",
            "Notes": "={{ $json.notes }}"
          },
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      }
    },
