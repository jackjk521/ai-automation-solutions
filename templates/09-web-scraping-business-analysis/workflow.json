    {
      "id": "c3d4e5f6-a7b8-9012-cdef-123456789012",
      "name": "SerpAPI Google Search",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [690, 300],
      "parameters": {
        "method": "GET",
        "url": "https://serpapi.com/search.json",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "={{ $json.niche + ' ' + $json.target_region }}"
            },
            {
              "name": "num",
              "value": "={{ $json.target_count }}"
            },
            {
              "name": "engine",
              "value": "google_local"
            },
            {
              "name": "api_key",
              "value": "={{ $env.SERPAPI_KEY }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "d4e5f6a7-b8c9-0123-defa-234567890123",
      "name": "Parse Search Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [910, 300],
      "parameters": {
        "jsCode": "const results = $input.first().json.local_results ?? $input.first().json.organic_results ?? [];\nconst niche = $('Set Config').first().json.niche;\nconst region = $('Set Config').first().json.target_region;\nreturn results.map(r => {\n  const url = r.website ?? r.link ?? '';\n  let domain = '';\n  try { domain = new URL(url).hostname.replace(/^www\\./, ''); } catch {}\n  return {\n    json: {\n      niche, region,\n      company: r.title ?? r.name ?? '',\n      url,\n      domain,\n      address: r.address ?? '',\n      phone: r.phone ?? '',\n      rating: r.rating ?? null,\n      reviews: r.reviews ?? 0,\n      has_website: !!url\n    }\n  };\n}).filter(r => r.json.company);\n"
      }
    },
    {
      "id": "e5f6a7b8-c9d0-1234-efab-345678901234",
      "name": "Loop Over Businesses",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [1130, 300],
      "parameters": {
        "batchSize": 1,
        "options": {}
      }
    },
    {
      "id": "f6a7b8c9-d0e1-2345-fabc-456789012345",
      "name": "Has Website?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1350, 300],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.has_website }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "a7b8c9d0-e1f2-3456-abcd-567890123456",
      "name": "BuiltWith Analyse Tech Stack",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1570, 180],
      "parameters": {
        "method": "GET",
        "url": "https://api.builtwith.com/free1/api.json",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "KEY",
              "value": "={{ $env.BUILTWITH_KEY }}"
            },
            {
              "name": "LOOKUP",
              "value": "={{ $json.domain }}"
            }
          ]
        },
        "options": {
          "timeout": 20000
        }
      }
    },
    {
      "id": "b8c9d0e1-f2a3-4567-bcde-678901234567",
      "name": "Score Website Quality",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1790, 180],
      "parameters": {
        "jsCode": "const lead = $('Loop Over Businesses').first().json;\nconst bw = $input.first().json;\nconst techGroups = bw.Results?.[0]?.Result?.Paths?.[0]?.Technologies ?? [];\nconst techNames = techGroups.map(t => t.Name ?? '');\nconst hasSSL = (lead.url ?? '').startsWith('https');\nconst oldCMS = ['WordPress 3','WordPress 4','Joomla','Drupal 6','Drupal 7'];\nconst modernFramework = ['React','Vue','Angular','Next.js','Nuxt'];\nlet score = 10;\nif (!hasSSL) score -= 3;\nif (techNames.some(t => oldCMS.some(o => t.includes(o)))) score -= 3;\nif (!techNames.some(t => modernFramework.some(f => t.includes(f)))) score -= 2;\nif (techNames.length < 3) score -= 2;\nscore = Math.max(0, score);\nconst priority = score <= 3 ? 'High' : score <= 6 ? 'Medium' : 'Low';\nreturn [{ json: {\n  ...lead,\n  tech_stack: techNames.join(', '),\n  has_ssl: hasSSL,\n  site_score: score,\n  priority\n}}];\n"
      }
    },
    {
      "id": "c9d0e1f2-a3b4-5678-cdef-789012345678",
      "name": "Mark No Website High Priority",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1570, 420],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "nw1",
              "name": "tech_stack",
              "value": "No website",
              "type": "string"
            },
            {
              "id": "nw2",
              "name": "has_ssl",
              "value": false,
              "type": "boolean"
            },
            {
              "id": "nw3",
              "name": "site_score",
              "value": 0,
              "type": "number"
            },
            {
              "id": "nw4",
              "name": "priority",
              "value": "High",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "d0e1f2a3-b4c5-6789-defa-890123456789",
      "name": "Merge Paths",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [2010, 300],
