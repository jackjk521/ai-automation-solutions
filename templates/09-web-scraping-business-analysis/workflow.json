    },
    {
      "id": "e1f2a3b4-c5d6-7890-efab-901234567890",
      "name": "Generate Outreach Email",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2230, 300],
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'claude-haiku-4-5-20251001', max_tokens: 500, messages: [{ role: 'user', content: 'Write a short cold outreach email for ' + $json.company + ' in ' + $json.region + '. Their website: ' + ($json.url || 'none') + '. Site score: ' + $json.site_score + '/10. Issues: SSL=' + $json.has_ssl + ', tech=' + $json.tech_stack + '. Format: SUBJECT: [subject line]\\n\\n[email body under 120 words]. Focus on one specific improvement.' }] }) }}",
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "f2a3b4c5-d6e7-8901-fabc-012345678901",
      "name": "Parse Email + Build Lead Record",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2450, 300],
      "parameters": {
        "jsCode": "const lead = $input.first().json;\nconst raw = lead.content?.[0]?.text ?? '';\nconst subjectMatch = raw.match(/SUBJECT:\\s*(.+)/i);\nconst subject = subjectMatch ? subjectMatch[1].trim() : 'We found issues on your website';\nconst body = raw.replace(/SUBJECT:.+\\n+/i, '').trim();\nconst followUpDate = new Date();\nfollowUpDate.setDate(followUpDate.getDate() + 7);\nreturn [{ json: {\n  date_added: new Date().toISOString().split('T')[0],\n  week: $('Set Config').first().json.week_number,\n  business_name: lead.company ?? '',\n  website_url: lead.url ?? '',\n  niche: lead.niche ?? '',\n  location: lead.region ?? '',\n  has_website: lead.has_website ? 'Yes' : 'No',\n  tech_stack: lead.tech_stack ?? '',\n  site_score: lead.site_score ?? 0,\n  priority: lead.priority ?? 'Medium',\n  has_ssl: lead.has_ssl ? 'Yes' : 'No',\n  phone: lead.phone ?? '',\n  address: lead.address ?? '',\n  email_subject: subject,\n  email_body: body,\n  outreach_status: 'Draft',\n  follow_up_date: followUpDate.toISOString().split('T')[0],\n  contract_value: '',\n  notes: ''\n}}];\n"
      }
    },
    {
